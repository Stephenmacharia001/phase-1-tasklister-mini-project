document.addEventListener("DOMContentLoaded", () => {
  // 1. Select the form and the container where tasks should be added
  const createTaskForm = document.getElementById("create-task-form") || document.querySelector("form");
  const taskListContainer = document.getElementById("tasks") || document.querySelector("ul");

  // Only run the code if both elements are successfully found on the webpage
  if (createTaskForm && taskListContainer) {
    createTaskForm.addEventListener("submit", (event) => {
      // 2. Prevent the form's default submission behavior from reloading the webpage
      event.preventDefault();

      // 3. Select the specific text input box field
      const taskInputField = document.getElementById("new-task-description") || createTaskForm.querySelector('input[type="text"]');
      
      if (taskInputField) {
        const taskInputValueText = taskInputField.value.trim();

        // 4. Ensure the input isn't empty before making changes to the DOM
        if (taskInputValueText !== "") {
          // Create a new list item element node
          const newListItem = document.createElement("li");
          
          // Inject the task string literal values cleanly
          newListItem.textContent = taskInputValueText;

          // Append your new list item element straight to the webpage task list container
          taskListContainer.appendChild(newListItem);

          // 5. Clear out the input field context value so a user can type a fresh task safely
          createTaskForm.reset();
        }
      }
    });
  }
});
