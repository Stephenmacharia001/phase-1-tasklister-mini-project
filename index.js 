document.addEventListener("DOMContentLoaded", () => {
  // 1. Select the form and the task list elements from the DOM
  const form = document.querySelector('form') || document.getElementById('create-task-form');
  const taskList = document.querySelector('ul') || document.getElementById('tasks') || document.getElementById('task-list');

  // Verify elements exist before adding the listener
  if (form && taskList) {
    form.addEventListener('submit', (event) => {
      // 2. Stop the form from refreshing the webpage on submission
      event.preventDefault();

      // 3. Locate the text input field
      const taskInput = form.querySelector('input[type="text"]') || document.getElementById('new-task-description') || document.getElementById('task-input');
      
      if (taskInput) {
        const taskText = taskInput.value.trim();

        // 4. Only append if the user actually typed something
        if (taskText !== '') {
          const listItem = document.createElement('li');
          listItem.textContent = taskText;
          
          // Append the new task ("Wash the dishes") to the list container
          taskList.appendChild(listItem);

          // 5. Clear out the input field so the user can type the next task
          form.reset();
        }
      }
    });
  }
});
